<!doctype html>
<html lang="zh">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>HISVIA 图片归档 v4 — 可用39张</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,"PingFang SC",sans-serif;background:#f0f2f5;color:#1a1a1a;padding:20px;line-height:1.5}
h1{font-size:20px;margin-bottom:4px}
.sub{font-size:12px;color:#666;margin-bottom:12px}
.summary{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px}
.stat{background:#fff;border:1px solid #ddd;border-radius:4px;padding:8px 14px;font-size:13px}
.stat b{font-size:18px;color:#1a6fb2}
.section-title{font-size:16px;font-weight:700;padding-bottom:6px;border-bottom:2px solid #1a6fb2;margin:20px 0 10px}
.group{background:#fff;border:1px solid #ddd;border-radius:6px;padding:14px;margin-bottom:12px}
.gh{display:flex;align-items:baseline;gap:8px;padding-bottom:8px;border-bottom:1px solid #eee}
.gh .cn{font-size:15px;font-weight:700}
.gh .cnt{font-size:12px;color:#666;margin-left:auto}
.row{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:12px;margin-top:10px}
.c{background:#fff;border:1px solid #ddd;border-radius:4px;overflow:hidden}
.c img{width:100%;height:180px;object-fit:contain;background:#fff;display:block;cursor:zoom-in;border-bottom:1px solid #eee}
.c img.zoom{position:fixed;top:5%;left:5%;width:90%;height:auto;max-height:90vh;z-index:99}
.lb{padding:8px 10px;font-size:11px}
.lb .nm{font-weight:700;font-size:12px;margin-bottom:3px}
.lb .desc{color:#555;font-size:11px}
.lb .fl{color:#999;font-size:10px;margin-top:3px;font-family:monospace}
</style></head><body>
<h1>HISVIA 图片归档 v4</h1>
<p class="sub">网上下载并审核通过的图片 · 剔除seal/rotor不合格后剩余39张</p>
<div class="summary">
<div class="stat"><b>39</b> 总可用</div>
<div class="stat"><b>14</b> 品牌整机</div>
<div class="stat"><b>25</b> 通用配件</div>
</div>
<div class="section-title">品牌整机（带品牌搜索）— 14张</div>
<div class="group"><div class="gh"><span class="cn">Atlas Copco 阿特拉斯</span><span class="cnt">3张</span></div><div class="row">
<div class="c"><img src="/photos/raw/_final/brand-machine-atlas-copco-2.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#2</div><div class="desc">箱式固定螺杆压缩机</div><div class="fl">brand-machine-atlas-copco-2.jpg</div></div></div>
<div class="c"><img src="/photos/raw/_final/brand-machine-atlas-copco-3.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#3</div><div class="desc">GA75VSD+ 螺杆压缩机</div><div class="fl">brand-machine-atlas-copco-3.jpg</div></div></div>
<div class="c"><img src="/photos/raw/_final/brand-machine-atlas-copco-4.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#4</div><div class="desc">箱式固定螺杆压缩机</div><div class="fl">brand-machine-atlas-copco-4.jpg</div></div></div>
</div></div>
<div class="group"><div class="gh"><span class="cn">Ingersoll Rand 英格索兰</span><span class="cnt">6张</span></div><div class="row">
<div class="c"><img src="/photos/raw/_final/brand-machine-ingersoll-rand-0.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#0</div><div class="desc">移动式压缩机</div><div class="fl">brand-machine-ingersoll-rand-0.jpg</div></div></div>
<div class="c"><img src="/photos/raw/_final/brand-machine-ingersoll-rand-1.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#1</div><div class="desc">移动式螺杆压缩机</div><div class="fl">brand-machine-ingersoll-rand-1.jpg</div></div></div>
<div class="c"><img src="/photos/raw/_final/brand-machine-ingersoll-rand-2.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#2</div><div class="desc">移动式压缩机</div><div class="fl">brand-machine-ingersoll-rand-2.jpg</div></div></div>
<div class="c"><img src="/photos/raw/_final/brand-machine-ingersoll-rand-3.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#3</div><div class="desc">移动式螺杆压缩机</div><div class="fl">brand-machine-ingersoll-rand-3.jpg</div></div></div>
<div class="c"><img src="/photos/raw/_final/brand-machine-ingersoll-rand-4.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#4</div><div class="desc">移动式螺杆压缩机</div><div class="fl">brand-machine-ingersoll-rand-4.jpg</div></div></div>
<div class="c"><img src="/photos/raw/_final/brand-machine-ingersoll-rand-5.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#5</div><div class="desc">移动式螺杆压缩机</div><div class="fl">brand-machine-ingersoll-rand-5.jpg</div></div></div>
</div></div>
<div class="group"><div class="gh"><span class="cn">Kaeser 凯撒</span><span class="cnt">2张</span></div><div class="row">
<div class="c"><img src="/photos/raw/_final/brand-machine-kaeser-0.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#0</div><div class="desc">移动式螺杆压缩机</div><div class="fl">brand-machine-kaeser-0.jpg</div></div></div>
<div class="c"><img src="/photos/raw/_final/brand-machine-kaeser-5.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#5</div><div class="desc">箱式压缩机</div><div class="fl">brand-machine-kaeser-5.jpg</div></div></div>
</div></div>
<div class="group"><div class="gh"><span class="cn">Hitachi 日立</span><span class="cnt">1张</span></div><div class="row">
<div class="c"><img src="/photos/raw/_final/brand-machine-hitachi-4.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#4</div><div class="desc">箱式螺杆压缩机</div><div class="fl">brand-machine-hitachi-4.jpg</div></div></div>
</div></div>
<div class="group"><div class="gh"><span class="cn">Gardner Denver</span><span class="cnt">2张</span></div><div class="row">
<div class="c"><img src="/photos/raw/_final/brand-machine-gardner-denver-4.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#4</div><div class="desc">螺杆式压缩机整机</div><div class="fl">brand-machine-gardner-denver-4.jpg</div></div></div>
<div class="c"><img src="/photos/raw/_final/brand-machine-gardner-denver-5.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#5</div><div class="desc">螺杆式压缩机整机</div><div class="fl">brand-machine-gardner-denver-5.jpg</div></div></div>
</div></div>
<div class="section-title">通用配件（不带品牌搜索）— 25张</div>
<div class="group"><div class="gh"><span class="cn">空压机滤芯 (Compressor Air/Oil Filter)</span><span class="cnt">2张</span></div><div class="row">
<div class="c"><img src="/photos/raw/_final/part-filter-1.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#1</div><div class="desc">空气滤芯</div><div class="fl">part-filter-1.jpg</div></div></div>
<div class="c"><img src="/photos/raw/_final/part-filter-4.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#4</div><div class="desc">空气滤芯</div><div class="fl">part-filter-4.jpg</div></div></div>
</div></div>
<div class="group"><div class="gh"><span class="cn">油气分离器 (Oil Separator Element)</span><span class="cnt">6张</span></div><div class="row">
<div class="c"><img src="/photos/raw/_final/part-oilsep-0.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#0</div><div class="desc">油气分离滤芯</div><div class="fl">part-oilsep-0.jpg</div></div></div>
<div class="c"><img src="/photos/raw/_final/part-oilsep-1.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#1</div><div class="desc">油气分离滤芯</div><div class="fl">part-oilsep-1.jpg</div></div></div>
<div class="c"><img src="/photos/raw/_final/part-oilsep-2.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#2</div><div class="desc">油气分离滤芯</div><div class="fl">part-oilsep-2.jpg</div></div></div>
<div class="c"><img src="/photos/raw/_final/part-oilsep-3.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#3</div><div class="desc">油气分离滤芯</div><div class="fl">part-oilsep-3.jpg</div></div></div>
<div class="c"><img src="/photos/raw/_final/part-oilsep-4.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#4</div><div class="desc">油气分离滤芯</div><div class="fl">part-oilsep-4.jpg</div></div></div>
<div class="c"><img src="/photos/raw/_final/part-oilsep-5.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#5</div><div class="desc">油气分离滤芯</div><div class="fl">part-oilsep-5.jpg</div></div></div>
</div></div>
<div class="group"><div class="gh"><span class="cn">压缩机阀件 (Compressor Valve)</span><span class="cnt">2张</span></div><div class="row">
<div class="c"><img src="/photos/raw/_final/part-valve-3.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#3</div><div class="desc">压缩机阀组</div><div class="fl">part-valve-3.jpg</div></div></div>
<div class="c"><img src="/photos/raw/_final/part-valve-5.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#5</div><div class="desc">压缩机电磁阀</div><div class="fl">part-valve-5.jpg</div></div></div>
</div></div>
<div class="group"><div class="gh"><span class="cn">工业轴承 (Industrial Bearing)</span><span class="cnt">2张</span></div><div class="row">
<div class="c"><img src="/photos/raw/_final/part-bearing-6.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#6</div><div class="desc">工业滚动轴承</div><div class="fl">part-bearing-6.jpg</div></div></div>
<div class="c"><img src="/photos/raw/_final/part-bearing-7.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#7</div><div class="desc">工业滚动轴承</div><div class="fl">part-bearing-7.jpg</div></div></div>
</div></div>
<div class="group"><div class="gh"><span class="cn">气动气缸 (Pneumatic Cylinder)</span><span class="cnt">2张</span></div><div class="row">
<div class="c"><img src="/photos/raw/_final/part-pneumatic-0.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#0</div><div class="desc">气动执行元件</div><div class="fl">part-pneumatic-0.jpg</div></div></div>
<div class="c"><img src="/photos/raw/_final/part-pneumatic-1.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#1</div><div class="desc">标准气缸</div><div class="fl">part-pneumatic-1.jpg</div></div></div>
</div></div>
<div class="group"><div class="gh"><span class="cn">工业泵 (Industrial Pump)</span><span class="cnt">3张</span></div><div class="row">
<div class="c"><img src="/photos/raw/_final/part-pump-0.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#0</div><div class="desc">工业离心泵</div><div class="fl">part-pump-0.jpg</div></div></div>
<div class="c"><img src="/photos/raw/_final/part-pump-3.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#3</div><div class="desc">离心泵/水泵</div><div class="fl">part-pump-3.jpg</div></div></div>
<div class="c"><img src="/photos/raw/_final/part-pump-6.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#6</div><div class="desc">不锈钢卧式泵</div><div class="fl">part-pump-6.jpg</div></div></div>
</div></div>
<div class="group"><div class="gh"><span class="cn">工业阀门 (Industrial Ball Valve)</span><span class="cnt">3张</span></div><div class="row">
<div class="c"><img src="/photos/raw/_final/part-ballvalve-0.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#0</div><div class="desc">不锈钢工业球阀</div><div class="fl">part-ballvalve-0.jpg</div></div></div>
<div class="c"><img src="/photos/raw/_final/part-ballvalve-1.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#1</div><div class="desc">工业球阀阀体</div><div class="fl">part-ballvalve-1.jpg</div></div></div>
<div class="c"><img src="/photos/raw/_final/part-ballvalve-4.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#4</div><div class="desc">工业阀门球阀</div><div class="fl">part-ballvalve-4.jpg</div></div></div>
</div></div>
<div class="group"><div class="gh"><span class="cn">PLC控制器 (PLC Module)</span><span class="cnt">3张</span></div><div class="row">
<div class="c"><img src="/photos/raw/_final/part-automation-1.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#1</div><div class="desc">PLC可编程控制器</div><div class="fl">part-automation-1.jpg</div></div></div>
<div class="c"><img src="/photos/raw/_final/part-automation-4.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#4</div><div class="desc">PLC控制模块</div><div class="fl">part-automation-4.jpg</div></div></div>
<div class="c"><img src="/photos/raw/_final/part-automation-6.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#6</div><div class="desc">PLC控制器</div><div class="fl">part-automation-6.jpg</div></div></div>
</div></div>
<div class="group"><div class="gh"><span class="cn">接近开关 / 传感器 (Proximity Sensor)</span><span class="cnt">2张</span></div><div class="row">
<div class="c"><img src="/photos/raw/_final/part-sensor-0.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#0</div><div class="desc">电感式接近传感器</div><div class="fl">part-sensor-0.jpg</div></div></div>
<div class="c"><img src="/photos/raw/_final/part-sensor-1.jpg" onclick="this.classList.toggle('zoom')"><div class="lb"><div class="nm">#1</div><div class="desc">接近开关</div><div class="fl">part-sensor-1.jpg</div></div></div>
</div></div>
</body></html>