<!doctype html><html lang="zh"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>品牌配件图审核 — Alibaba精准品牌搜索</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,"PingFang SC",sans-serif;background:#f0f2f5;color:#1a1a1a;padding:24px;line-height:1.5}
h1{font-size:22px;margin-bottom:4px}
.sub{font-size:13px;color:#666;margin-bottom:6px}
.summary{background:#fff;border:1px solid #ddd;border-radius:6px;padding:14px 16px;margin:12px 0 20px;font-size:13px}
.stat{display:flex;gap:10px;margin-top:10px;flex-wrap:wrap}
.stat span{font-size:12.5px;padding:5px 10px;border-radius:3px}
.group{background:#fff;border:1px solid #ddd;border-radius:6px;padding:16px;margin-bottom:18px}
.gh{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;padding-bottom:10px;border-bottom:1px solid #eee}
.gh .num{font-size:12px;font-weight:700;color:#fff;background:#1a6fb2;padding:2px 8px;border-radius:3px}
.gh .cn{font-size:16px;font-weight:700}
.row{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:10px;margin-top:12px}
.c{border:2px solid;border-radius:5px;overflow:hidden}
.c img{width:100%;height:170px;object-fit:contain;background:#fff;display:block;cursor:zoom-in;border-bottom:1px solid #eee}
.c img.zoom{position:fixed;top:5%;left:5%;width:90%;height:auto;max-height:90vh;z-index:99}
.lb{padding:7px 9px;font-size:10.5px}
.lb .tag{font-size:11px;font-weight:700;padding:2px 6px;border-radius:2px;display:inline-block;margin-bottom:4px}
.lb .field{margin-top:3px;color:#444}
.lb .field b{color:#1a1a1a;font-weight:600}
.lb .bad{color:#c0392b}
.warn{background:#fde8e8;border:1px solid #f5c6c6;color:#c0392b;padding:10px;border-radius:4px;font-size:12.5px;margin-top:10px}
.ok{background:#eafaf1;border:1px solid #b8e8c8;color:#1a7a3a;padding:10px;border-radius:4px;font-size:12.5px;margin-top:10px}
</style></head><body>
