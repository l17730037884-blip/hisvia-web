<div class="imgs">
<div class="img-box"><div class="tag">原图</div><img src="/photos/raw/_docx6/image233.jpeg" onerror="this.parentElement.innerHTML='❌'" loading="lazy"/></div>
<div class="img-box"><div class="tag">抠图</div><img src="/assets/cutout_results/asset-7c915fca_nobg.png" style="background:url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2220%22 height=%2220%22><rect width=%2210%22 height=%2210%22 fill=%22%23ccc%22/><rect x=%2210%22 y=%2210%22 width=%2210%22 height=%2210%22 fill=%22%23ccc%22/></svg>')" onerror="this.parentElement.innerHTML='❌'" loading="lazy"/></div>
