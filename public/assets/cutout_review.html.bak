<!DOCTYPE html>
<html lang="zh"><head><meta charset="utf-8"/><title>抠图审核 · HISVIA</title>
<style>
:root{--bg:#0f0f1a;--card:#1a1a30;--border:#2a2a4a;--text:#c8c8d8;--red:#e74c3c;--yellow:#f39c12;--green:#27ae60;--blue:#3498db;--purple:#9b59b6;--orange:#e67e22}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,"PingFang SC",sans-serif;background:var(--bg);color:var(--text);padding:12px}
h1{font-size:16px}
.topbar{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:10px}
.stats{display:flex;gap:8px;flex-wrap:wrap}
.stat{padding:6px 12px;border-radius:6px;font-weight:700;font-size:12px}
.stat.green{background:#1d3020;border:1px solid var(--green);color:var(--green)}
.stat.yellow{background:#3d3020;border:1px solid var(--yellow);color:var(--yellow)}
.stat.red{background:#3d1d20;border:1px solid var(--red);color:var(--red)}
.actions{display:flex;gap:6px;margin-left:auto;flex-wrap:wrap}
.btn{padding:6px 12px;border:1px solid var(--border);border-radius:4px;background:var(--card);color:var(--text);cursor:pointer;font-size:11px}
.btn:hover{opacity:.8}
.btn.confirm{border-color:var(--green);color:var(--green)}
.btn.reset{border-color:var(--yellow);color:var(--yellow)}
.btn.export{border-color:var(--blue);color:var(--blue)}
.filters{display:flex;gap:12px;margin-bottom:10px;flex-wrap:wrap;font-size:11px}
.filters label{cursor:pointer;display:flex;align-items:center;gap:4px}
.grid{display:flex;flex-direction:column;gap:6px}
.row{display:flex;gap:8px;background:var(--card);border:1px solid var(--border);border-radius:8px;padding:8px;align-items:flex-start;transition:opacity .3s,transform .3s}
.row.abandoned{opacity:.3;border-color:#555}
.row.confirmed{border-color:var(--green);border-width:2px}
.row .imgs{display:flex;gap:6px;flex:1;min-width:0}
.row .img-box{flex:1;min-width:180px;display:flex;flex-direction:column;align-items:center;background:#0a0a1a;border-radius:6px;padding:6px;position:relative}
.row .img-box img{width:100%;max-height:240px;object-fit:contain}
.tag{position:absolute;top:4px;left:4px;background:rgba(0,0,0,.75);color:#fff;font-size:9px;padding:1px 5px;border-radius:2px}
.qc{width:240px;min-width:240px;padding:6px 8px;font-size:10px;line-height:1.5}
.fn{font-weight:700;font-size:11px;word-break:break-all;margin-bottom:3px}
.badge{padding:1px 5px;border-radius:3px;font-size:8px;font-weight:700;color:#fff}
.badge.pass{background:var(--green)}.badge.review{background:var(--yellow);color:#000}
.metric{display:inline-block;padding:1px 4px;border-radius:2px;margin:1px;font-size:8px;font-family:monospace}
.metric.red{background:#3d2020;color:var(--red)}.metric.green{background:#1d3020;color:var(--green)}.metric.orange{background:#3d2d1d;color:var(--orange)}.metric.blue{background:#1d2d3d;color:var(--blue)}
.issue{font-size:9px;padding:1px 0}.issue.green{color:var(--green)}.issue.yellow{color:var(--yellow)}
.score{font-size:24px;font-weight:900;text-align:center;padding:0 6px;min-width:50px}
.toast{position:fixed;bottom:20px;right:20px;background:var(--green);color:#fff;padding:10px 20px;border-radius:6px;font-weight:700;font-size:12px;z-index:200;display:none}
.btns{display:flex;flex-direction:column;gap:4px;min-width:60px}
.btn-keep,.btn-abandon{padding:4px 10px;border:1px solid;border-radius:4px;background:transparent;cursor:pointer;font-size:10px;font-weight:700;white-space:nowrap}
.btn-keep{color:var(--green);border-color:var(--green)}
.btn-keep.active{background:var(--green);color:#fff}
.btn-abandon{color:var(--red);border-color:var(--red)}
.btn-abandon.active{background:var(--red);color:#fff}
</style></head><body>
<div class="topbar">
<h1>🔬 抠图审核 · HISVIA</h1>
<div class="stats">
<span class="stat green">PASS 276</span>
<span class="stat yellow">REVIEW 60</span>
<span class="stat red">FAIL 9</span>
<span class="stat" id="stat-abandoned" style="background:#2d1d1d;border:1px solid var(--red);color:var(--red)">已放弃 0</span>
<span class="stat" id="stat-confirmed" style="background:#1d2d1d;border:1px solid var(--green);color:var(--green)">已确认 0</span>
</div>
<div class="actions">
<button class="btn confirm" onclick="confirmAll()">✅ 一键确认全部通过</button>
<button class="btn archive" onclick="archiveAll()" style="border-color:var(--purple);color:var(--purple)">📦 一键归档到资产库</button>
<button class="btn reset" onclick="resetAll()">🔄 重置</button>
<button class="btn export" onclick="exportData()">📤 导出</button>
</div>
</div>
<div class="filters">
<label><input type="checkbox" checked onchange="applyFilter()" data-filter="pass"> PASS</label>
<label><input type="checkbox" checked onchange="applyFilter()" data-filter="review"> REVIEW</label>
<label><input type="checkbox" checked onchange="applyFilter()" data-filter="fail"> FAIL</label>
<label><input type="checkbox" checked onchange="applyFilter()" data-filter="abandoned"> 已放弃</label>
<label><input type="checkbox" checked onchange="applyFilter()" data-filter="confirmed"> 已确认</label>
</div>
<div class="grid" id="grid">
<div class="row" data-fname="asset-3905f805" data-verdict="pass">
