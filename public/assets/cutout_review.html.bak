</div>
</div>
<div class="row" data-fname="asset-17a6fe69" data-verdict="pass">
<div class="score" style="color:#27ae60">94</div>
<div class="imgs">
<div class="img-box"><div class="tag">原图</div><img src="/photos/raw/_docx6/image237.jpeg" onerror="this.parentElement.innerHTML='❌'" loading="lazy"/></div>
<div class="img-box"><div class="tag">抠图</div><img src="/assets/cutout_results/asset-17a6fe69_nobg.png" style="background:url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2220%22 height=%2220%22><rect width=%2210%22 height=%2210%22 fill=%22%23ccc%22/><rect x=%2210%22 y=%2210%22 width=%2210%22 height=%2210%22 fill=%22%23ccc%22/></svg>')" onerror="this.parentElement.innerHTML='❌'" loading="lazy"/></div>
</div>
<div class="btns">
<button class="btn-keep" onclick="markKeep('asset-17a6fe69')">✅ 通过</button>
<button class="btn-abandon" onclick="markAbandon('asset-17a6fe69')">❌ 放弃</button>
</div>
<div class="qc">
<div class="fn">asset-17a6fe69 <span class="badge pass">PASS</span> <span class="badge" style="background:var(--orange)">industrial</span></div>
<span class="metric orange">IND79</span>
<span class="metric blue">DIFF28</span>
<span class="metric blue">edge_dilate</span>
<span class="metric green">召回100%</span>
<div class="issue yellow">背景残留38.7%</div>
</div>
</div>
</div>
<div class="toast" id="toast"></div>

<script>
var state = JSON.parse(localStorage.getItem("cutout_review_v2") || "{}");

function saveState() {
    localStorage.setItem("cutout_review_v2", JSON.stringify(state));
    updateStats();
    applyFilter();
}

function getStatus(fname) { return state[fname] || null; }

function setStatus(fname, s) {
    if (!s) delete state[fname];
    else state[fname] = s;
    saveState();
}

function toast(msg) {
    var t = document.getElementById("toast");
    t.textContent = msg;
    t.style.display = "block";
    clearTimeout(t._tid);
    t._tid = setTimeout(function(){ t.style.display = "none"; }, 2000);
}

function markKeep(fname) {
    if (getStatus(fname) === "keep") {
        fetch("/api/cutout/review", {
            method: "POST",
            headers: {"Content-Type": "application/json"},
            body: JSON.stringify({action: "keep", filename: fname, undo: true})
        }).then(function(r){ return r.json(); }).then(function(data){
            setStatus(fname, null);
            toast("↩️ " + fname + " 取消确认");
        }).catch(function(e){
            toast("❌ 请求失败: " + e.message);
        });
    } else {
        fetch("/api/cutout/review", {
            method: "POST",
            headers: {"Content-Type": "application/json"},
            body: JSON.stringify({action: "keep", filename: fname})
        }).then(function(r){ return r.json(); }).then(function(data){
            if (data.success) {
                setStatus(fname, "keep");
                toast("✅ " + fname + " 已确认通过");
            } else {
                toast("❌ " + (data.error || "失败"));
            }
        }).catch(function(e){
            toast("❌ 请求失败: " + e.message);
        });
    }
}

function markAbandon(fname) {
    if (getStatus(fname) === "abandon") {
        setStatus(fname, null);
        toast("↩️ " + fname + " 已恢复");
        return;
    }
    
    fetch("/api/cutout/review", {
        method: "POST",
        headers: {"Content-Type": "application/json"},
        body: JSON.stringify({action: "abandon", filename: fname})
    }).then(function(r){ return r.json(); }).then(function(data){
        if (data.success) {
            setStatus(fname, "abandon");
            var row = document.querySelector('.row[data-fname="' + fname + '"]');
            if (row) {
                row.style.opacity = "0";
                row.style.transform = "scale(0.95)";
                row.style.transition = "all 0.3s";
                setTimeout(function(){ row.remove(); updateStats(); }, 300);
            }
            toast("🗑️ " + fname + " 已放弃");
            setTimeout(function(){ location.reload(); }, 1500);
        } else {
            toast("❌ " + (data.error || "失败"));
        }
    }).catch(function(e){
        toast("❌ 请求失败: " + e.message);
    });
}

function updateStats() {
    var abandoned = 0, confirmed = 0;
    for (var k in state) {
        if (state[k] === "abandon") abandoned++;
        if (state[k] === "keep") confirmed++;
    }
    document.getElementById("stat-abandoned").textContent = "已放弃 " + abandoned;
    document.getElementById("stat-confirmed").textContent = "已确认 " + confirmed;
}

function applyFilter() {
    var showPass = document.querySelector("[data-filter=pass]").checked;
    var showReview = document.querySelector("[data-filter=review]").checked;
    var showFail = document.querySelector("[data-filter=fail]").checked;
    var showAbandoned = document.querySelector("[data-filter=abandoned]").checked;
    var showConfirmed = document.querySelector("[data-filter=confirmed]").checked;
    
    var rows = document.querySelectorAll(".row");
    for (var i = 0; i < rows.length; i++) {
        var row = rows[i];
        var fname = row.getAttribute("data-fname");
        var verdict = row.getAttribute("data-verdict");
        var status = getStatus(fname);
        
        row.classList.remove("abandoned", "confirmed");
        if (status === "abandon") row.classList.add("abandoned");
        if (status === "keep") row.classList.add("confirmed");
        
        var keepBtn = row.querySelector(".btn-keep");
        var abandonBtn = row.querySelector(".btn-abandon");
        if (keepBtn) {
            if (status === "keep") keepBtn.classList.add("active");
            else keepBtn.classList.remove("active");
        }
        if (abandonBtn) {
            if (status === "abandon") abandonBtn.classList.add("active");
            else abandonBtn.classList.remove("active");
        }
        
        var show = true;
        if (verdict === "pass" && !showPass) show = false;
        if (verdict === "review" && !showReview) show = false;
        if (verdict === "fail" && !showFail) show = false;
        if (status === "abandon" && !showAbandoned) show = false;
        if (status === "keep" && !showConfirmed) show = false;
        row.style.display = show ? "flex" : "none";
    }
}

function confirmAll() {
    if (!confirm("确认全部 PASS 图片通过审核？")) return;
    var rows = document.querySelectorAll(".row");
    var fnames = [];
    for (var i = 0; i < rows.length; i++) {
        var row = rows[i];
        var verdict = row.getAttribute("data-verdict");
        var fname = row.getAttribute("data-fname");
        if (verdict === "pass" && getStatus(fname) !== "abandon") {
            fnames.push(fname);
        }
    }
    if (fnames.length === 0) { toast("没有可确认的图片"); return; }
    toast("⏳ 正在确认 " + fnames.length + " 张...");
    var done = 0;
    fnames.forEach(function(fname) {
        fetch("/api/cutout/review", {
            method: "POST",
            headers: {"Content-Type": "application/json"},
            body: JSON.stringify({action: "keep", filename: fname})
        }).then(function(r){ return r.json(); }).then(function(data){
            if (data.success) setStatus(fname, "keep");
        }).finally(function() {
            done++;
            if (done >= fnames.length) {
                saveState();
                toast("✅ 已确认 " + fnames.length + " 张");
            }
        });
    });
}

function archiveAll() {
    var confirmed = 0;
    for (var k in state) { if (state[k] === "keep") confirmed++; }
    if (confirmed === 0) { toast("⚠️ 没有已确认的图片"); return; }
    if (!confirm("将 " + confirmed + " 张已确认通过的抠图归档到资产库？")) return;
    
    toast("⏳ 正在归档...");
    fetch("/api/cutout/review", {
        method: "POST",
        headers: {"Content-Type": "application/json"},
        body: JSON.stringify({action: "archive_all"})
    }).then(function(r){ return r.json(); }).then(function(data){
        if (data.success) {
            toast("📦 已归档 " + data.archived + " 张到资产库！");
            setTimeout(function(){ location.reload(); }, 2000);
        } else {
            toast("❌ " + (data.error || "归档失败"));
        }
    }).catch(function(e){
        toast("❌ 请求失败: " + e.message);
    });
}

function resetAll() {
    if (!confirm("清除所有标记状态？")) return;
    state = {};
    saveState();
    toast("🔄 已重置");
}

function exportData() {
    var data = {};
    var rows = document.querySelectorAll(".row");
    for (var i = 0; i < rows.length; i++) {
        var fname = rows[i].getAttribute("data-fname");
        data[fname] = getStatus(fname) || "pending";
    }
    var blob = new Blob([JSON.stringify(data, null, 2)], {type: "application/json"});
    var a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = "cutout_review_state.json";
    a.click();
}

updateStats();
applyFilter();
</script>
</body></html>