<button class="btn-abandon" onclick="markAbandon('asset-7c915fca')">❌ 放弃</button>
</div>
<div class="qc">
<div class="fn">asset-7c915fca <span class="badge pass">PASS</span> <span class="badge" style="background:var(--orange)">industrial</span></div>
<span class="metric orange">IND79</span>
<span class="metric blue">DIFF35</span>
<span class="metric blue">edge_dilate</span>
<span class="metric green">召回100%</span>
