<!DOCTYPE html><html lang="zh"><head><meta charset="utf-8"/><title>白底v1/v2/v3</title>
<style>
:root{--bg:#1a1a2e;--card:#16213e;--border:#2a2a4a;--text:#e0e0e0}
*{box-sizing:border-box;margin:0;padding:0}body{font-family:-apple-system,"PingFang SC",sans-serif;background:var(--bg);color:var(--text)}
header{background:var(--card);border-bottom:1px solid var(--border);padding:10px 20px}
.pair{display:flex;margin:8px 20px;background:var(--card);border:1px solid var(--border);border-radius:8px;overflow:hidden}
.ib{flex:1;min-width:180px;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#0a0a1a;padding:6px;position:relative;min-height:160px}
.ib img{max-width:100%;max-height:200px;object-fit:contain}
.lbl{position:absolute;top:4px;left:4px;background:rgba(0,0,0,.7);color:#fff;font-size:7px;padding:1px 4px;border-radius:2px}
.qc{width:120px;min-width:120px;padding:8px;display:flex;align-items:center;font-size:9px}
</style></head><body>
