{
  "version": "1.0",
  "elevations": {
    "card": {
      "class": "card-elevated",
      "value": "0 4px 16px rgba(14,42,74,0.06), 0 1px 3px rgba(14,42,74,0.04)",
      "hover": "0 8px 24px rgba(14,42,74,0.09), 0 2px 6px rgba(14,42,74,0.05)",
      "usage": "Product cards, factory cards, content cards"
    },
    "header": {
      "class": "shadow-[0_1px_20px_-8px_rgba(14,42,74,0.08)]",
      "usage": "Sticky header"
    },
    "dropdown": {
      "class": "shadow-[0_12px_40px_rgba(14,42,74,0.12)]",
      "usage": "Navigation dropdowns"
    },
    "none": {
      "class": "shadow-none",
      "usage": "Flat sections, text-only areas"
    }
  },
  "rules": [
    "All shadows use navy (#0E2A4A) as base color",
    "Never use pure black shadows",
    "Card hover translates -6px Y + deeper shadow",
    "No shadow on mobile cards (performance)"
  ]
}
