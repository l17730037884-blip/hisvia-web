{
  "version": "v1",
  "description": "HISVIA Conversion Event Tracking Schema. Real events only. No simulated data.",
  "event_types": {
    "page_view": {
      "description": "User lands on a HISVIA page",
      "fields": ["event_id", "timestamp", "page_url", "locale", "referrer", "utm_source", "utm_medium", "utm_campaign", "device_type", "country_geo"],
      "target_pages": ["/", "/solutions/*", "/industries/*", "/about", "/capability-network", "/partners/*", "/oem", "/request"]
    },
    "cta_click": {
      "description": "User clicks a call-to-action button",
      "fields": ["event_id", "timestamp", "page_url", "cta_type", "cta_label", "cta_destination"],
      "cta_types": ["request_quote", "contact_us", "view_system", "learn_more", "partner_inquire"]
    },
    "rfq_start": {
      "description": "User begins filling the RFQ form",
      "fields": ["event_id", "timestamp", "page_url", "referrer", "locale"],
      "trigger": "First field interaction on /request form"
    },
    "rfq_field_complete": {
      "description": "User completes a section of the RFQ form",
      "fields": ["event_id", "timestamp", "field_group", "completion_pct"],
      "field_groups": ["buyer_info", "requirement", "product_details", "contact"]
    },
    "rfq_submit": {
      "description": "User submits the completed RFQ form",
      "fields": ["event_id", "timestamp", "rfq_id", "system_type", "country", "industry", "source_channel"]
    },
    "rfq_abandon": {
      "description": "User starts RFQ but does not submit",
      "fields": ["event_id", "timestamp", "completion_pct", "last_field_group", "time_spent_seconds"]
    },
    "solution_page_engagement": {
      "description": "User scrolls >50% or spends >30s on a solution page",
      "fields": ["event_id", "timestamp", "page_url", "system_type", "scroll_depth_pct", "time_spent_seconds"]
    },
    "image_view": {
      "description": "User views an asset image in gallery",
      "fields": ["event_id", "timestamp", "asset_id", "page_url", "view_duration_ms"]
    }
  },
  "conversion_funnel": {
    "description": "Standard conversion path with target rates",
    "stages": [
      { "stage": "page_view", "description": "Landing page visit", "target_next_rate": ">15% to CTA click" },
      { "stage": "cta_click", "description": "CTA engagement", "target_next_rate": ">30% to RFQ start" },
      { "stage": "rfq_start", "description": "RFQ form opened", "target_next_rate": ">50% to RFQ submit" },
      { "stage": "rfq_submit", "description": "RFQ completed and submitted", "target_next_rate": ">80% to match" },
      { "stage": "rfq_match", "description": "RFQ matched to system/supplier", "target_next_rate": ">60% to quotation" },
      { "stage": "quotation", "description": "Supplier provides quotation", "target_next_rate": ">30% to close" },
      { "stage": "closed", "description": "Deal completed", "target_next_rate": "N/A" }
    ]
  },
  "events": [],
  "summary": {
    "total_page_views": 0,
    "total_cta_clicks": 0,
    "total_rfq_starts": 0,
    "total_rfq_submits": 0,
    "total_rfq_abandons": 0,
    "rfq_completion_rate": "N/A",
    "cta_click_rate": "N/A",
    "visitor_to_rfq_rate": "N/A"
  },
  "rules": [
    "All events must originate from real user interactions",
    "Never inject simulated events for testing in production",
    "UTM parameters must be set on outbound links, not fabricated",
    "Event counts are honest — zero until real traffic occurs",
    "GDPR: No personal data stored in events without consent"
  ]
}
