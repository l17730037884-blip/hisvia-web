{
  "version": "v1",
  "description": "HISVIA Buyer Acquisition Tracking Schema. Real buyers only. No fabricated data.",
  "schema": {
    "identity": {
      "buyer_id": { "type": "string", "format": "BUY-{timestamp}-{random}", "required": true },
      "company_name": { "type": "string", "required": true },
      "country": { "type": "string", "required": true },
      "city": { "type": "string", "required": false },
      "industry": { "type": "string", "required": true, "enum": ["mining", "oil_gas", "manufacturing", "construction", "water_treatment", "food", "pharma", "marine", "power", "other"] },
      "company_size": { "type": "string", "required": false, "enum": ["small", "medium", "large", "enterprise"] }
    },
    "buyer_classification": {
      "buyer_type": { "type": "string", "required": true, "enum": ["industrial_distributor", "repair_service", "maintenance_company", "oem_manufacturer", "engineering_company", "trading_company", "end_user", "agent", "other"] },
      "purchase_authority": { "type": "string", "required": false, "enum": ["decision_maker", "influencer", "researcher", "unknown"] },
      "annual_import_volume": { "type": "string", "required": false, "description": "Estimated annual import volume in USD or units" }
    },
    "contact": {
      "contact_name": { "type": "string", "required": true },
      "contact_role": { "type": "string", "required": false },
      "contact_email": { "type": "string", "required": true },
      "contact_phone": { "type": "string", "required": false },
      "contact_linkedin": { "type": "string", "required": false },
      "preferred_language": { "type": "string", "required": false, "enum": ["en", "ru", "zh", "ar", "other"] }
    },
    "acquisition": {
      "source_channel": { "type": "string", "required": true, "enum": ["website_form", "linkedin_outreach", "email_outreach", "exhibition", "b2b_platform", "partner_referral", "inbound_search", "direct_contact", "other"] },
      "first_contact_date": { "type": "string", "required": true, "format": "date" },
      "discovered_by": { "type": "string", "required": false }
    },
    "interest": {
      "interest_categories": { "type": "array", "required": false, "items": { "type": "string" }, "description": "HISVIA system categories buyer expressed interest in" },
      "requirement_description": { "type": "string", "required": false },
      "urgency": { "type": "string", "required": false, "enum": ["low", "medium", "high", "urgent"] },
      "budget_indication": { "type": "string", "required": false }
    },
    "status": {
      "current": { "type": "string", "required": true, "enum": ["discovered", "contacted", "replied", "qualified", "converted", "lost", "inactive"] },
      "status_history": { "type": "array", "items": { "status": "string", "timestamp": "string", "note": "string" } },
      "assigned_to": { "type": "string", "required": false },
      "next_follow_up": { "type": "string", "required": false, "format": "date" }
    }
  },
  "status_flow": {
    "discovered": { "description": "Buyer identified but not yet contacted", "next": ["contacted", "lost"] },
    "contacted": { "description": "Initial outreach sent, awaiting response", "next": ["replied", "lost"] },
    "replied": { "description": "Buyer responded, conversation started", "next": ["qualified", "lost"] },
    "qualified": { "description": "Buyer has genuine requirement and budget", "next": ["converted", "lost"] },
    "converted": { "description": "RFQ submitted or partnership established", "next": [] },
    "lost": { "description": "No response or not interested", "next": [] },
    "inactive": { "description": "Temporarily inactive, may re-engage", "next": ["contacted"] }
  },
  "rules": [
    "Every buyer must be a real company/person — no fabricated profiles",
    "Contact status must be based on actual communication",
    "Never auto-generate buyer profiles for metrics",
    "Buyer count displayed honestly — 0 until real outreach begins",
    "GDPR/privacy: Store only information voluntarily provided by buyer"
  ],
  "current_buyer_count": 0
}
