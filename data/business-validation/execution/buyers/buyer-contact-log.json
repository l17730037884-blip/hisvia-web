{
  "version": "v1",
  "description": "HISVIA Buyer Outreach Execution Log. Real contacts only. No fabricated entries.",
  "schema": {
    "contact_entry": {
      "buyer_id": { "type": "string", "format": "BUY-{timestamp}-{random}", "required": true },
      "company_name": { "type": "string", "required": true },
      "country": { "type": "string", "required": true },
      "city": { "type": "string", "required": false },
      "industry": { "type": "string", "required": true, "enum": ["mining", "oil_gas", "manufacturing", "construction", "water_treatment", "food", "pharma", "marine", "power", "other"] },
      "buyer_type": { "type": "string", "required": true, "enum": ["industrial_distributor", "repair_service", "maintenance_company", "oem_manufacturer", "engineering_company", "trading_company", "end_user", "agent", "other"] },
      "source": { "type": "string", "required": true, "enum": ["linkedin", "email_outreach", "b2b_platform", "exhibition", "website_form", "partner_referral", "telegram", "direct_contact", "other"] },
      "source_detail": { "type": "string", "required": false, "description": "LinkedIn URL, platform name, exhibition name" },
      "contact_person": { "type": "string", "required": false },
      "contact_role": { "type": "string", "required": false },
      "contact_email": { "type": "string", "required": false },
      "contact_linkedin": { "type": "string", "required": false },
      "contact_date": { "type": "string", "required": true, "format": "date" },
      "response": { "type": "string", "required": false, "description": "Summary of buyer's response" },
      "interest_system": { "type": "array", "required": false, "items": { "type": "string" }, "description": "HISVIA system types buyer expressed interest in" },
      "requirement_summary": { "type": "string", "required": false },
      "rfq_submitted": { "type": "boolean", "default": false },
      "rfq_id": { "type": "string", "required": false },
      "status": { "type": "string", "required": true, "enum": ["identified", "contacted", "replied", "qualified", "rfq_submitted", "negotiating", "closed", "lost"] },
      "next_action": { "type": "string", "required": false },
      "next_contact_date": { "type": "string", "required": false, "format": "date" },
      "notes": { "type": "string", "required": false },
      "follow_up_count": { "type": "integer", "default": 0 }
    }
  },
  "status_flow": {
    "identified": { "description": "Buyer company identified and researched", "next": ["contacted"] },
    "contacted": { "description": "Initial outreach sent (LinkedIn/email/etc)", "next": ["replied", "lost"] },
    "replied": { "description": "Buyer responded, conversation started", "next": ["qualified", "lost"] },
    "qualified": { "description": "Buyer has genuine requirement, budget, and authority", "next": ["rfq_submitted", "lost"] },
    "rfq_submitted": { "description": "Formal RFQ received from buyer", "next": ["negotiating", "closed", "lost"] },
    "negotiating": { "description": "Active negotiation with supplier(s)", "next": ["closed", "lost"] },
    "closed": { "description": "Deal completed or partnership established", "next": [] },
    "lost": { "description": "No response, not interested, or deal lost", "next": [] }
  },
  "contacts": [],
  "summary": {
    "total_identified": 0,
    "total_contacted": 0,
    "total_replied": 0,
    "total_qualified": 0,
    "total_rfq_submitted": 0,
    "total_closed": 0,
    "total_lost": 0
  },
  "rules": [
    "Every entry must correspond to a real company and real contact attempt",
    "Never auto-generate buyer contact entries",
    "Status changes require documented communication",
    "RFQ linkage must reference a real submitted RFQ",
    "All counts are honest — zero until real outreach occurs",
    "GDPR: Only store information voluntarily provided or publicly available"
  ]
}
