{
  "version": "v1",
  "description": "HISVIA Supplier Recruitment Execution Log. Real contacts only. No fabricated entries.",
  "schema": {
    "contact_entry": {
      "supplier_id": { "type": "string", "format": "SUP-{timestamp}-{random}", "required": true },
      "company_name": { "type": "string", "required": true },
      "company_name_cn": { "type": "string", "required": false, "description": "Chinese company name" },
      "category": { "type": "string", "required": true, "description": "HISVIA system type" },
      "product_focus": { "type": "string", "required": false },
      "location": { "type": "string", "required": true, "description": "City, Province, China" },
      "source": { "type": "string", "required": true, "enum": ["alibaba", "made_in_china", "global_sources", "exhibition", "referral", "wechat_group", "direct_visit", "inbound", "other"] },
      "source_detail": { "type": "string", "required": false, "description": "URL, exhibition name, referrer name" },
      "contact_method": { "type": "string", "required": true, "enum": ["email", "wechat", "phone", "alibaba_message", "in_person", "other"] },
      "contact_person": { "type": "string", "required": false },
      "contact_role": { "type": "string", "required": false },
      "contact_date": { "type": "string", "required": true, "format": "date" },
      "response": { "type": "string", "required": false, "description": "Summary of factory's response" },
      "interest_level": { "type": "string", "required": false, "enum": ["high", "medium", "low", "none"] },
      "next_action": { "type": "string", "required": false },
      "next_contact_date": { "type": "string", "required": false, "format": "date" },
      "status": { "type": "string", "required": true, "enum": ["identified", "contacted", "replied", "meeting", "approved", "onboarded", "rejected"] },
      "notes": { "type": "string", "required": false },
      "follow_up_count": { "type": "integer", "default": 0 }
    }
  },
  "status_flow": {
    "identified": { "description": "Factory found and researched, ready for contact", "next": ["contacted"] },
    "contacted": { "description": "Initial outreach sent", "next": ["replied", "rejected"] },
    "replied": { "description": "Factory responded, conversation started", "next": ["meeting", "rejected"] },
    "meeting": { "description": "Meeting/call scheduled or completed", "next": ["approved", "rejected"] },
    "approved": { "description": "Documents received, internal approval given", "next": ["onboarded"] },
    "onboarded": { "description": "Factory active on HISVIA platform", "next": [] },
    "rejected": { "description": "Not suitable or not interested", "next": [] }
  },
  "contacts": [],
  "summary": {
    "total_identified": 0,
    "total_contacted": 0,
    "total_replied": 0,
    "total_meetings": 0,
    "total_approved": 0,
    "total_onboarded": 0,
    "total_rejected": 0
  },
  "rules": [
    "Every entry must correspond to a real factory and real contact attempt",
    "Never auto-generate contact entries",
    "Response and interest_level require actual communication to fill",
    "Source must be traceable (URL, exhibition name, referrer)",
    "All counts are honest — zero until real activity occurs"
  ]
}
