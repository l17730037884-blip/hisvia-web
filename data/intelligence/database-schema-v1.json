{
  "version": "v1",
  "phase": 15,
  "description": "HISVIA Production Database Schema — Future PostgreSQL/Prisma target",
  "tables": {
    "factories": {
      "description": "Verified Chinese manufacturing factories",
      "columns": {
        "factory_id": { "type": "UUID", "pk": true, "default": "uuidv4" },
        "company_name": { "type": "VARCHAR(255)", "not_null": true },
        "location": { "type": "VARCHAR(100)", "not_null": true },
        "region": { "type": "VARCHAR(50)" },
        "industry": { "type": "VARCHAR(100)" },
        "system_capability": { "type": "TEXT[]", "description": "Array of system type enums" },
        "product_capability": { "type": "TEXT[]" },
        "manufacturing_processes": { "type": "TEXT[]", "description": "CNC, casting, forging, assembly, etc." },
        "equipment_capability": { "type": "TEXT[]" },
        "certifications": { "type": "JSONB", "description": "[{name, body, valid_until}]" },
        "export_experience_years": { "type": "INTEGER" },
        "export_markets": { "type": "TEXT[]", "description": "Countries exported to" },
        "export_volume_pct": { "type": "INTEGER" },
        "production_capacity_monthly": { "type": "VARCHAR(50)" },
        "factory_size_sqm": { "type": "INTEGER" },
        "employee_count": { "type": "INTEGER" },
        "quality_control": { "type": "JSONB", "description": "{system, inspections, lab}" },
        "lead_time_days": { "type": "JSONB", "description": "{standard, rush}" },
        "moq": { "type": "JSONB", "description": "{value, unit}" },
        "verified_status": { "type": "VARCHAR(20)", "default": "unverified", "enum": ["verified", "unverified", "pending", "rejected"] },
        "verified_at": { "type": "TIMESTAMP" },
        "created_at": { "type": "TIMESTAMP", "default": "NOW()" },
        "updated_at": { "type": "TIMESTAMP", "default": "NOW()" }
      },
      "indexes": ["location", "system_capability", "verified_status"]
    },
    "buyers": {
      "description": "Overseas industrial buyers",
      "columns": {
        "buyer_id": { "type": "UUID", "pk": true },
        "country": { "type": "VARCHAR(50)", "not_null": true },
        "industry": { "type": "VARCHAR(100)" },
        "company_name": { "type": "VARCHAR(255)" },
        "contact_email": { "type": "VARCHAR(255)" },
        "requirements_history": { "type": "JSONB", "default": "[]" },
        "preferred_systems": { "type": "TEXT[]" },
        "created_at": { "type": "TIMESTAMP", "default": "NOW()" }
      }
    },
    "rfqs": {
      "description": "Request for Quotation records",
      "columns": {
        "rfq_id": { "type": "UUID", "pk": true },
        "buyer_id": { "type": "UUID", "fk": "buyers.buyer_id" },
        "requirement": { "type": "JSONB", "description": "Full requirement object" },
        "parsed_system": { "type": "VARCHAR(100)" },
        "parsed_category": { "type": "VARCHAR(100)" },
        "parsed_brand": { "type": "VARCHAR(100)" },
        "matching_result": { "type": "JSONB", "description": "MatchResult from engine" },
        "matched_factory_ids": { "type": "UUID[]" },
        "status": { "type": "VARCHAR(20)", "default": "pending", "enum": ["pending", "analyzed", "matched", "quoted", "ordered", "completed", "cancelled"] },
        "urgency": { "type": "VARCHAR(10)", "default": "medium" },
        "quantity": { "type": "VARCHAR(50)" },
        "created_at": { "type": "TIMESTAMP", "default": "NOW()" },
        "updated_at": { "type": "TIMESTAMP", "default": "NOW()" }
      },
      "indexes": ["buyer_id", "status", "parsed_system"]
    },
    "partners": {
      "description": "Regional distribution/service partners",
      "columns": {
        "partner_id": { "type": "UUID", "pk": true },
        "country": { "type": "VARCHAR(50)", "not_null": true },
        "region": { "type": "VARCHAR(50)" },
        "city": { "type": "VARCHAR(100)" },
        "partner_type": { "type": "VARCHAR(30)", "enum": ["distributor", "service_center", "agent", "engineering_firm", "oem_partner"] },
        "company_name": { "type": "VARCHAR(255)" },
        "industries": { "type": "TEXT[]" },
        "customer_types": { "type": "TEXT[]" },
        "local_network": { "type": "TEXT" },
        "sales_capability": { "type": "INTEGER" },
        "technical_background": { "type": "TEXT" },
        "preferred_categories": { "type": "TEXT[]" },
        "performance_score": { "type": "FLOAT" },
        "referrals_count": { "type": "INTEGER", "default": 0 },
        "created_at": { "type": "TIMESTAMP", "default": "NOW()" }
      }
    },
    "events": {
      "description": "Supply chain flywheel events",
      "columns": {
        "event_id": { "type": "UUID", "pk": true },
        "event_type": { "type": "VARCHAR(40)", "not_null": true },
        "actor_type": { "type": "VARCHAR(20)" },
        "actor_id": { "type": "VARCHAR(100)" },
        "source": { "type": "VARCHAR(50)" },
        "related_assets": { "type": "UUID[]" },
        "related_supplier": { "type": "UUID" },
        "related_market": { "type": "VARCHAR(50)" },
        "result": { "type": "VARCHAR(100)" },
        "metadata": { "type": "JSONB" },
        "created_at": { "type": "TIMESTAMP", "default": "NOW()" }
      },
      "indexes": ["event_type", "actor_id", "related_market", "created_at"]
    },
    "knowledge_entries": {
      "description": "Pending knowledge discoveries from flywheel",
      "columns": {
        "entry_id": { "type": "UUID", "pk": true },
        "source_event": { "type": "UUID" },
        "type": { "type": "VARCHAR(30)" },
        "data": { "type": "JSONB" },
        "confidence": { "type": "FLOAT" },
        "status": { "type": "VARCHAR(20)", "default": "pending_review" },
        "created_at": { "type": "TIMESTAMP", "default": "NOW()" }
      }
    },
    "feedback": {
      "description": "Buyer/supplier/partner feedback",
      "columns": {
        "feedback_id": { "type": "UUID", "pk": true },
        "event_id": { "type": "UUID" },
        "feedback_type": { "type": "VARCHAR(30)" },
        "match_quality": { "type": "VARCHAR(20)" },
        "conversion_status": { "type": "VARCHAR(20)" },
        "rating": { "type": "INTEGER" },
        "comments": { "type": "TEXT" },
        "pain_points": { "type": "TEXT[]" },
        "suggestions": { "type": "TEXT[]" },
        "created_at": { "type": "TIMESTAMP", "default": "NOW()" }
      }
    }
  },
  "notes": [
    "This schema is for FUTURE database implementation.",
    "DO NOT create tables yet — Phase 15 is read-only integration test.",
    "All current data lives in JSON files under data/asset-pipeline/.",
    "Factory verification is manual — no auto-approval."
  ]
}
