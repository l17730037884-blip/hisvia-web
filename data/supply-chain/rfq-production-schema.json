{
  "version": "v1",
  "description": "HISVIA Production RFQ Schema. Real buyer requirements only.",
  "schema": {
    "buyer": {
      "rfq_id": { "type": "string", "format": "RFQ-{timestamp}-{random}", "required": true },
      "country": { "type": "string", "required": true, "description": "Buyer's country" },
      "company": { "type": "string", "required": false, "description": "Company name" },
      "contact_name": { "type": "string", "required": true },
      "contact_email": { "type": "string", "required": true },
      "contact_phone": { "type": "string", "required": false },
      "industry": { "type": "string", "required": false, "enum": ["mining", "oil_gas", "manufacturing", "construction", "water_treatment", "food", "pharma", "other"] }
    },
    "requirement": {
      "system_type": { "type": "string", "required": false, "description": "HISVIA system type" },
      "product_category": { "type": "string", "required": false },
      "brand_reference": { "type": "string", "required": false, "description": "OEM brand/model for reference" },
      "part_number": { "type": "string", "required": false },
      "description": { "type": "string", "required": true, "description": "Free-text requirement description" },
      "quantity": { "type": "string", "required": false },
      "target_price": { "type": "string", "required": false },
      "target_delivery": { "type": "string", "required": false, "description": "Required delivery date" },
      "urgency": { "type": "string", "required": false, "enum": ["low", "medium", "high", "urgent"] },
      "attachments": { "type": "array", "required": false, "description": "Drawings, photos, specs" }
    },
    "matching": {
      "matched_systems": { "type": "array", "required": false },
      "matched_categories": { "type": "array", "required": false },
      "matched_factories": { "type": "array", "required": false },
      "match_confidence": { "type": "number", "required": false, "minimum": 0, "maximum": 1 },
      "matching_notes": { "type": "string", "required": false }
    },
    "status": {
      "current": { "type": "string", "required": true, "enum": ["new", "qualified", "matching", "supplier_contacted", "quoted", "negotiating", "closed_won", "closed_lost", "cancelled"] },
      "status_history": { "type": "array", "items": { "status": "string", "timestamp": "string", "note": "string" } },
      "assigned_to": { "type": "string", "required": false }
    }
  },
  "status_flow": {
    "new": { "description": "RFQ received, not yet reviewed", "next": ["qualified", "cancelled"] },
    "qualified": { "description": "Buyer requirement validated and understood", "next": ["matching", "cancelled"] },
    "matching": { "description": "Matching engine running, factories being identified", "next": ["supplier_contacted", "cancelled"] },
    "supplier_contacted": { "description": "Matched factories contacted for quotation", "next": ["quoted", "cancelled"] },
    "quoted": { "description": "Quotation received from factory", "next": ["negotiating", "closed_lost"] },
    "negotiating": { "description": "Price/terms under negotiation", "next": ["closed_won", "closed_lost"] },
    "closed_won": { "description": "Order confirmed", "next": [] },
    "closed_lost": { "description": "No deal reached", "next": [] },
    "cancelled": { "description": "RFQ cancelled by buyer or HISVIA", "next": [] }
  },
  "rules": [
    "Every RFQ must have a real buyer contact",
    "Never auto-generate fake RFQs",
    "Status changes must be documented with timestamp",
    "Closed RFQs must have a reason recorded"
  ]
}
