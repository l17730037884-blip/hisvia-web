{
  "version": "v1",
  "description": "HISVIA Factory Onboarding Profile Schema. All fields required for verification. No fake data permitted.",
  "schema": {
    "identity": {
      "factory_id": { "type": "string", "format": "FAC-XXX-NNN", "required": true, "description": "Unique factory identifier" },
      "company_name": { "type": "string", "required": true, "description": "Registered Chinese company name" },
      "company_name_en": { "type": "string", "required": false, "description": "English company name for export use" },
      "location": { "type": "string", "required": true, "description": "City, Province, China" },
      "region": { "type": "string", "required": true, "enum": ["Zhejiang", "Jiangsu", "Shanghai", "Guangdong", "Shandong", "Hebei", "Other"] },
      "established_year": { "type": "integer", "required": true },
      "employee_count": { "type": "integer", "required": true },
      "factory_size_sqm": { "type": "integer", "required": false }
    },
    "manufacturing": {
      "capabilities": { "type": "array", "required": true, "items": { "enum": ["cnc_machining", "casting", "forging", "stamping", "welding", "assembly", "testing", "surface_treatment", "customization", "reverse_engineering"] } },
      "processes": { "type": "array", "required": true, "description": "Detailed manufacturing processes" },
      "equipment": { "type": "array", "required": true, "description": "Key production equipment list" },
      "materials": { "type": "array", "required": true, "description": "Materials handled (carbon steel, stainless, aluminum, etc.)" }
    },
    "products": {
      "categories": { "type": "array", "required": true, "description": "Product categories from HISVIA taxonomy" },
      "models": { "type": "array", "required": false, "description": "Product model numbers" },
      "compatible_brands": { "type": "array", "required": false, "description": "OEM brands this factory has experience with" },
      "system_types": { "type": "array", "required": true, "description": "HISVIA system types covered" }
    },
    "quality": {
      "certificates": { "type": "array", "required": true, "items": { "name": "string", "body": "string", "valid_until": "string" } },
      "inspection_process": { "type": "string", "required": true, "description": "Inspection process description" },
      "quality_control": { "type": "string", "required": true, "description": "QC system description" }
    },
    "export": {
      "export_countries": { "type": "array", "required": true, "description": "Countries exported to" },
      "export_experience_years": { "type": "integer", "required": true },
      "export_volume_pct": { "type": "integer", "required": false },
      "incoterms": { "type": "array", "required": false, "items": { "enum": ["FOB", "CIF", "EXW", "DAP"] } }
    },
    "media": {
      "factory_images": { "type": "array", "required": false, "description": "Exterior and facility photos" },
      "production_images": { "type": "array", "required": false, "description": "Production line photos" },
      "inspection_images": { "type": "array", "required": false, "description": "QC and testing photos" }
    },
    "verification": {
      "document_verified": { "type": "boolean", "default": false, "description": "Business license and certificates verified" },
      "factory_verified": { "type": "boolean", "default": false, "description": "On-site audit completed" },
      "partner_verified": { "type": "boolean", "default": false, "description": "Proven track record established" },
      "verified_at": { "type": "string", "format": "date-time", "required": false },
      "verified_by": { "type": "string", "required": false }
    }
  },
  "rules": [
    "All factory data must be verified before publication",
    "No fictional factories permitted",
    "All certificates must be validated against issuing body",
    "Export experience must be documented with references",
    "Media images must be real factory photos — no AI-generated images"
  ]
}
