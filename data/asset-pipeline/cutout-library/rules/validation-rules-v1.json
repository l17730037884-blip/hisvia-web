{
  "version": "1.0",
  "description": "Automatic schema validation rules for AI output before ingestion.",
  "checks": [
    {
      "id": "V001",
      "check": "system_type must be from allowed enum or null",
      "field": "system_type",
      "rule": "Must be one of 8 fixed values, null, or 'unknown'.",
      "valid_values": [
        "Air Compressor Systems",
        "Hydraulic Systems",
        "Pneumatic Automation",
        "Industrial Filtration",
        "Pumps & Fluid Handling",
        "Valves & Flow Control",
        "Industrial Automation & Control",
        "Mechanical Transmission",
        null,
        "unknown"
      ],
      "severity": "error"
    },
    {
      "id": "V002",
      "check": "system_type must not be 'Factory'",
      "severity": "error"
    },
    {
      "id": "V003",
      "check": "Forbidden as system_type: Seal, Filter, Bearing, etc.",
      "forbidden": [
        "Seal",
        "Sealing Components",
        "Filter",
        "Filter Element",
        "Bearing",
        "Coupling",
        "Gearbox",
        "Dryer",
        "Oil Separator",
        "Factory",
        "Maintenance"
      ],
      "severity": "error"
    },
    {
      "id": "V004",
      "check": "asset_type must be valid enum",
      "valid_values": [
        "equipment",
        "component",
        "factory",
        "brand_asset",
        "application_scene",
        "technical_document",
        "unknown"
      ],
      "severity": "error"
    },
    {
      "id": "V005",
      "check": "confidence must be 0-1",
      "severity": "error"
    },
    {
      "id": "V006",
      "check": "null/unknown/ambiguous are valid and must not be rejected",
      "severity": "info"
    },
    {
      "id": "V007",
      "check": "category must exist in taxonomy for given system_type",
      "severity": "warning"
    },
    {
      "id": "V008",
      "check": "AI must not overwrite human-locked fields",
      "severity": "error"
    },
    {
      "id": "V009",
      "check": "AI output must be valid JSON matching Stage B schema",
      "severity": "error"
    }
  ]
}